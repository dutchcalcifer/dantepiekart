# Copy to .env for local development. Set the same values in Vercel.
# Find these in Supabase's Connect dialog or Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Admin login: choose a password of at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Use a random secret of at least 32 characters to encrypt session cookies.
ADMIN_SESSION_SECRET=
