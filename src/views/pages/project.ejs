<article class="project version-1 version-5">
  <h1><%= project.title %></h1>
  <% for (const paragraph of project.paragraphs) { %>
    <p><%= paragraph %></p>
  <% } %>

  <% if (project.skills.length) { %>
    <h2 class="project-heading"><%= project.skillsLabel %></h2>
    <ul>
      <% for (const skill of project.skills) { %>
        <li><%= skill %></li>
      <% } %>
    </ul>
  <% } %>

  <%- include('../partials/case-study', { caseStudy: project.caseStudy }) %>

  <% for (const link of project.links) { %>
    <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer" class="margin"><%= link.label %></a>
  <% } %>
  <a href="/portfolio" class="margin back">BACK</a>
</article>
