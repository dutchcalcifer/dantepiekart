<% const navigation = [ ['/', 'HOME'], ['/about', 'ABOUT ME'], ['/portfolio', 'PORTFOLIO'], ['/education', 'EDUCATION'], ['/contact', 'CONTACT'] ]; %>
<ul>
  <% for (const [href, label] of navigation) { %>
    <% const active = href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href + '/'); %>
    <li><a href="<%= href %>" class="<%= active ? 'active' : '' %>" <% if (currentPath === href) { %>aria-current="page"<% } %>><%= label %></a></li>
  <% } %>
  <li class="nav-admin"><a href="<%= isAdmin ? '/admin' : '/admin/login' %>" class="<%= currentPath.startsWith('/admin') ? 'active' : '' %>" <% if (currentPath === (isAdmin ? '/admin' : '/admin/login')) { %>aria-current="page"<% } %>><%= isAdmin ? 'ADMIN' : 'ADMIN LOGIN' %></a></li>
</ul>
