<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dante Piekart <%= title %></title>
    <meta
      name="description"
      content="Digital Designer with Front-end Skills."
    />
    <link
      rel="preload"
      href="/fonts/inter.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/saira.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/saira-condensed.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="preload" href="/css/styles.css" as="style" />
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
  </head>
  <body>
    <div class="background-outer-container">
      <div class="background-inner-container">
        <div class="blob <%= currentPath !== '/' ? 'darken' : '' %>"></div>
      </div>
    </div>
    <header>
      <a href="/"><img src="/vectors/logo.svg" alt="logo" /></a>
      <nav>
        <ul>
          <li>
            <input type="checkbox" id="menu" />
            <label for="menu">Menu</label>
          </li>
          <li>
            <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>"
              >HOME</a
            >
          </li>
          <li>
            <a
              href="/about"
              class="<%= currentPath.startsWith('/about') ? 'active' : '' %>"
              >ABOUT ME</a
            >
          </li>
          <li>
            <a
              href="/portfolio"
              class="<%= currentPath.startsWith('/portfolio') ? 'active' : '' %>"
              >PORTFOLIO</a
            >
          </li>
          <li>
            <a
              href="/education"
              class="<%= currentPath.startsWith('/education') ? 'active' : '' %>"
              >EDUCATION</a
            >
          </li>
          <li>
            <a
              href="/contact"
              class="<%= currentPath.startsWith('/contact') ? 'active' : '' %>"
              >CONTACT</a
            >
          </li>
        </ul>
      </nav>
      <label for="menu" class="nav-overlay"></label>
    </header>
    <main><%- body %></main>
    <footer>
      <p>&copy; 2026 Dante Piekart. All rights reserved.</p>
    </footer>
    <script>
      window.va =
        window.va ||
        function () {
          (window.vaq = window.vaq || []).push(arguments);
        };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>

    <script>
      window.si =
        window.si ||
        function () {
          (window.siq = window.siq || []).push(arguments);
        };
    </script>
    <script defer src="/_vercel/speed-insights/script.js"></script>
  </body>
</html>
